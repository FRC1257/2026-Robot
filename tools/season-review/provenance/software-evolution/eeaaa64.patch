+    public Command runVoltageRamp() {
+        Timer timer = new Timer();
+
+        return runVoltageCommand(() -> {
+            double time = timer.get();
+            double percent = Math.min(time/3.0, 1.0);
+            return Volts.of(12.0*percent);
+        }).beforeStarting(timer::restart);
+    }
